  "mixins": [{ "config": "skinmod.mixins.json", "environment": "client" }],
  "depends": { "fabricloader": ">=0.16.0", "minecraft": "~1.21.4", "fabric-api": "*" },
  "suggests": { "figura": "*", "plasmovoice": "*" }
