  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "icon": "assets/skinmod/icon.png",
  "entrypoints": {
    "main": ["dev.custommodskin.runtime.fabric.SkinModFabric"],
